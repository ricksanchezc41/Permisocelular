rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Ayudas ----------
    function esAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/administradores/$(request.auth.uid))
        && get(/databases/$(database)/documents/administradores/$(request.auth.uid)).data.activo == true;
    }
    function esSuper() {
      return esAdmin()
        && get(/databases/$(database)/documents/administradores/$(request.auth.uid)).data.rol == 'superadmin';
    }
    function ruta(col, id) { return /databases/$(database)/documents/$(col)/$(id); }
    // Un empleado con solicitud pendiente/rechazada hace menos de 30 días no puede volver a pedir.
    function sinBloqueoVigente(emp) {
      return !exists(ruta('bloqueos', emp))
        || get(ruta('bloqueos', emp)).data.fecha < request.time - duration.value(30, 'd');
    }

    // ---------- usuarios ----------
    // Cualquiera puede consultar SU documento si conoce el número (igual que la app original),
    // pero solo los administradores pueden listar a todos.
    match /usuarios/{id} {
      allow get: if true;
      allow list: if esAdmin();
      allow create: if esAdmin() || autoAprobado(id);
      allow update: if esAdmin() || marcarExpirado() || normalizarEstado() || pedirRenovacion();
      allow delete: if esAdmin();

      // Aprobación automática por encuesta correcta + uso de trabajo (vigencia máx. 2 meses)
      function autoAprobado(emp) {
        let d = request.resource.data;
        return d.keys().hasOnly(['nombre','area','supervisor','tipo_uso','descripcion','permiso_aprobado','estado',
                                 'fecha_registro','fecha_aprobacion','fecha_vigencia','aprobado_por','renovacion_pendiente'])
          && d.tipo_uso == 'Trabajo' && d.permiso_aprobado == true && d.estado == 'activo'
          && d.aprobado_por == 'sistema (encuesta aprobada)' && d.renovacion_pendiente == false
          && d.fecha_registro == request.time && d.fecha_aprobacion == request.time
          && d.fecha_vigencia > request.time && d.fecha_vigencia <= request.time + duration.value(63, 'd')
          && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 120
          && sinBloqueoVigente(emp);
      }
      // El empleado, al consultar, marca como expirado un permiso cuya vigencia ya pasó
      function marcarExpirado() {
        let d = request.resource.data; let r = resource.data;
        return d.diff(r).affectedKeys().hasOnly(['permiso_aprobado','estado','last_modified','modified_by'])
          && 'fecha_vigencia' in r && r.fecha_vigencia != null && r.fecha_vigencia < request.time
          && d.permiso_aprobado == false && d.estado == 'expirado';
      }
      function normalizarEstado() {
        let d = request.resource.data; let r = resource.data;
        return d.diff(r).affectedKeys().hasOnly(['estado','last_modified','modified_by'])
          && r.permiso_aprobado == true && 'fecha_vigencia' in r && r.fecha_vigencia != null
          && r.fecha_vigencia >= request.time && d.estado == 'activo';
      }
      function pedirRenovacion() {
        let d = request.resource.data; let r = resource.data;
        return d.diff(r).affectedKeys().hasOnly(['renovacion_pendiente'])
          && d.renovacion_pendiente == true && r.get('renovacion_pendiente', false) == false;
      }
    }

    // ---------- solicitudes ----------
    match /solicitudes/{id} {
      allow read: if esAdmin();
      allow create: if esAdmin() || solicitudPublica();
      allow update: if esAdmin();

      function solicitudPublica() {
        let d = request.resource.data;
        return d.keys().hasOnly(['numero_empleado','nombre','area','supervisor','tipo_uso','descripcion','estado',
                                 'fecha_solicitud','fecha_proceso','procesado_por','comentarios','tipo_solicitud','fecha_vigencia_solicitada'])
          && d.fecha_solicitud == request.time
          && d.numero_empleado is string && d.numero_empleado.size() > 0 && d.numero_empleado.size() <= 30
          && d.nombre is string && d.nombre.size() <= 120
          && d.descripcion is string && d.descripcion.size() <= 4000
          && (!('fecha_vigencia_solicitada' in d) || d.fecha_vigencia_solicitada <= request.time + duration.value(63, 'd'))
          && (nuevaPublica(d) || renovacionPublica(d));
      }
      function nuevaPublica(d) {
        return d.tipo_solicitud == 'nueva' && (
          // pendiente (uso personal) o rechazada por el sistema: exigen registrar el bloqueo de 30 días
          ((( d.estado == 'pendiente' && !('procesado_por' in d))
             || (d.estado == 'rechazada' && d.procesado_por == 'sistema'))
            && getAfter(ruta('bloqueos', d.numero_empleado)).data.fecha == request.time)
          // aprobada automáticamente: solo junto con el usuario creado por la regla autoAprobado
          || (d.estado == 'aprobada' && d.procesado_por == 'sistema'
              && getAfter(ruta('usuarios', d.numero_empleado)).data.aprobado_por == 'sistema (encuesta aprobada)')
        );
      }
      function renovacionPublica(d) {
        return d.tipo_solicitud == 'renovacion' && d.estado == 'pendiente' && !('procesado_por' in d)
          && exists(ruta('usuarios', d.numero_empleado))
          && getAfter(ruta('usuarios', d.numero_empleado)).data.renovacion_pendiente == true;
      }
    }

    // ---------- bloqueos (control de reenvío de solicitudes, 30 días) ----------
    match /bloqueos/{id} {
      allow get: if true;
      allow create: if bloqueoValido(id);
      allow update: if esAdmin() || (bloqueoValido(id) && resource.data.fecha < request.time - duration.value(30, 'd'));
      allow delete: if esAdmin();

      function bloqueoValido(emp) {
        let d = request.resource.data;
        return d.keys().hasOnly(['fecha','solicitud_id']) && d.fecha == request.time
          && getAfter(ruta('solicitudes', d.solicitud_id)).data.numero_empleado == emp;
      }
    }

    // ---------- administradores ----------
    match /administradores/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || esSuper());
      allow list: if esSuper();
      allow create: if esSuper() || primerAdmin(uid);
      allow update: if esSuper()
        || (request.auth != null && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimo_acceso']));
      allow delete: if false;

      // Primera instalación: solo mientras no exista config/setup
      function primerAdmin(adm) {
        return request.auth != null && request.auth.uid == adm
          && !exists(ruta('config', 'setup'))
          && request.resource.data.rol == 'superadmin' && request.resource.data.activo == true
          && getAfter(ruta('config', 'setup')).data.uid == adm;
      }
    }
    match /config/{doc} {
      allow get: if true;
      allow create: if doc == 'setup' && request.auth != null
        && request.resource.data.uid == request.auth.uid
        && getAfter(ruta('administradores', request.auth.uid)).data.rol == 'superadmin';
      allow update, delete: if false;
    }

    // ---------- auditoría e historial de eliminados (solo administradores) ----------
    match /usuario_audits/{id} { allow read, create: if esAdmin(); }
    match /usuarios_eliminados/{id} { allow read, create: if esAdmin(); }
  }
}
